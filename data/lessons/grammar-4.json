          }
        },
        {
          "id": "grammar-4-x1",
          "group": "grammar-4-x1",
          "type": "choice",
          "prompt": "多益實戰：選出最適合的答案",
          "options": [
            "thorough",
            "thoroughly",
            "thoroughness",
            "more thorough"
          ],
          "answer": "thoroughly",
          "explanation": "句子已經完整（主詞＋動詞＋受詞），空格修飾動作 reviewed，用副詞 thoroughly。",
          "sentence": "The manager reviewed the budget ___ before the meeting.",
          "zh": "經理在會議前仔細審查了預算。"
        }
      ]
    }
