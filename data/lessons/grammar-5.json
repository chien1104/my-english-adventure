        },
        {
          "en": "I sent the email yesterday.",
          "zh": "我昨天寄了那封電子郵件。",
          "highlight": "sent",
          "audio": "assets/audio/lessons/grammar-5/ex3.mp3"
        },
        {
          "en": "Did you finish the report?",
          "zh": "你完成報告了嗎？",
          "highlight": "Did",
          "audio": "assets/audio/lessons/grammar-5/ex4.mp3"
        }
      ]
    },
