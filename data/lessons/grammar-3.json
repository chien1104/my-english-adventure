          ],
          "answer": "phone",
          "explanation": "a 是「一個」，後面用單數 phone。"
        },
        {
          "id": "g3-pick-b",
          "group": "g3-pick",
          "type": "choice",
          "prompt": "哪一句是正確的？",
          "zh": "他有三個箱子。",
          "options": [
