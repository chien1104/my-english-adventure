          "group": "g3-x",
          "type": "choice",
          "prompt": "選出正確答案",
          "sentence": "I see two ___.",
          "zh": "我看到兩台公車。",
          "options": [
            "bus",
            "buses",
            "buss"
          ],
          "answer": "buses",
          "explanation": "bus 是 s 結尾，複數加 es：buses。"
        },
        {
          "id": "g3-ch-b",
          "group": "g3-ch",
          "type": "choice",
          "prompt": "選出正確答案",
          "sentence": "We need four ___.",
          "zh": "我們需要四個盤子。",
          "options": [
            "dish",
            "dishs",
            "dishes"
          ],
          "answer": "dishes",
          "explanation": "dish（盤子）是 sh 結尾，複數加 es：dishes。"
        },
        {
          "id": "g3-one-b",
          "group": "g3-one",
          "type": "choice",
          "prompt": "選出正確答案",
